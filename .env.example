# Copy to .env and fill with real values (never commit .env)
GATEWAY_API_KEY=<GATEWAY_API_KEY>
GATEWAY_URL=http://127.0.0.1:20128
PROXY_TARGET=http://127.0.0.1:20128/v1

# === OmniRoute management ===
OMNIROUTE_MANAGE_KEY=<sk-...>       # scope=manage, manual desde Dashboard → API Keys
ADMIN_KEY=<auto-generated>          # setup.sh lo genera automáticamente

# === Provider API keys (setup.sh los inyecta en OmniRoute) ===
# NVIDIA free tier: 1 cuenta alcanza, ponelo en NVIDIA_API_KEY
# Si tenés múltiples cuentas: NVIDIA_API_KEY_1/2/3
NVIDIA_API_KEY=nvapi-...
# NVIDIA_API_KEY_2=nvapi-...
# NVIDIA_API_KEY_3=nvapi-...

OPENROUTER_API_KEY=sk-or-...
GROQ_API_KEY=gsk-...
# GEMINI_API_KEY=...               # Gemini free 1500 req/día
# GEMINI_API_KEY_2=...
MISTRAL_API_KEY=...